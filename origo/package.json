{
  "name": "origo",
  "productName": "Origo",
  "version": "0.1.0",
  "private": true,
  "description": "Origo - desktop workspace for the IITPSx assembler and emulator.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "electron .",
    "bundle:binaries": "node scripts/ensure-binaries.mjs",
    "package:win": "npm run build && npm run bundle:binaries && electron-builder --win",
    "package:nsis": "npm run build && npm run bundle:binaries && electron-builder --win nsis",
    "package:portable": "npm run build && npm run bundle:binaries && electron-builder --win portable"
  },
  "build": {
    "appId": "com.origo.iitpsx",
    "productName": "Origo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "afterPack": "build/after-pack.cjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.2",
    "electron-builder": "^25.1.8",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.11"
  }
}
